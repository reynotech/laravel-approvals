{
    "name": "reynotech/laravel-approvals",
    "description": "Approval workflows for Eloquent models: capture pending changes, gate them behind N approvers/disapprovers, and apply the diff once approved.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "eloquent", "approval", "workflow", "moderation"],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "illuminate/events": "^11.0 || ^12.0 || ^13.0",
        "spatie/laravel-schemaless-attributes": "^2.6"
    },
    "suggest": {
        "spatie/laravel-medialibrary": "Allows attaching images to pending modifications via Concerns\\HasModificationMedia.",
        "spatie/laravel-schemaless-attributes": "Allows applying approved diffs onto schemaless attribute columns."
    },
    "autoload": {
        "psr-4": {
            "ReynoTECH\\Approvals\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ReynoTECH\\Approvals\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ReynoTECH\\Approvals\\ApprovalsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "release:patch": "bin/bump-version.sh patch",
        "release:minor": "bin/bump-version.sh minor",
        "release:major": "bin/bump-version.sh major"
    },
    "authors": [
        {
            "name": "Samuel Casas",
            "email": "samuel@reyno.tech"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
